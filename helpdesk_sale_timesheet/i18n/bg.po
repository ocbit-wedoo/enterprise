msgid ""
"<span class=\"fa fa-exclamation-triangle text-warning\" title=\"The sales "
"order associated with this ticket has been cancelled. We recommend either "
"updating the sales order item or cancelling this ticket in alignment with "
"the cancellation of the sales order.\" invisible=\"sale_order_state != "
"'cancel'\"/>"
msgstr ""
"<span class=\"fa fa-exclamation-triangle text-warning\" title=\"Поръчката за "
"продажба, свързана с този тикет, е отменена. Препоръчваме да актуализирате "
"артикула от поръчката за продажба или да откажете този тикет в съответствие "
"с отказването на поръчката за продажба.\" invisible=\"sale_order_state != "
"'cancel'\"/>"

