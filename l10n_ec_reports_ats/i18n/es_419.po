#. module: l10n_ec_reports_ats
#. odoo-python
#: code:addons/l10n_ec_reports_ats/models/tax_report.py:0
msgid "%(invoice)s: Import invoice lines should have at most one VAT tax."
msgstr ""
"%(invoice)s: Las líneas de una factura de importación deben tener como "
"máximo un impuesto de IVA."

#. module: l10n_ec_reports_ats
#. odoo-python
#: code:addons/l10n_ec_reports_ats/models/tax_report.py:0
msgid "%(invoice)s: Invoice lines should have exactly one VAT tax."
msgstr ""
"%(invoice)s: Las líneas de factura deben tener exactamente un impuesto de "
"IVA."

#. module: l10n_ec_reports_ats
#. odoo-python
#: code:addons/l10n_ec_reports_ats/models/tax_report.py:0
msgid ""
"%(invoice)s: The credit (NCs) or debit (NDs) note doesn't have the invoice "
"that modifies it. It must be created from the original invoice"
msgstr ""
"%(invoice)s: La nota de crédito (NC) o nota de débito (ND) no tiene la "
"factura que la modifica; debes crearla desde la factura original"

#. module: l10n_ec_reports_ats
#. odoo-python
#: code:addons/l10n_ec_reports_ats/models/tax_report.py:0
msgid "%s: IR tax without 3 digit ats code"
msgstr "%s: Impuesto IR sin codigo ats de 3 digitos"

#. module: l10n_ec_reports_ats
#. odoo-python
#: code:addons/l10n_ec_reports_ats/models/tax_report.py:0
msgid "%s: Invoice lines should have exactly one VAT tax."
msgstr "%s: Las líneas de factura deben tener exactamente un impuesto de IVA."

