"                <table style=\"width:600px;margin:5px auto;\">\n"
"                    <tbody>\n"
"                        <tr><td t-if=\"not "
"object.company_id.uses_default_logo\">\n"
"                            <a href=\"/\"><img t-attf-src=\"/logo.png?"
"company={{ object.company_id.id }}\" style=\"vertical-align:baseline;max-"
"width:100px;\"/></a>\n"
"                        </td><td style=\"text-align:right;vertical-"
"align:middle;\">\n"
"                                Subscription Renewal\n"
"                        </td></tr>\n"
"                    </tbody>\n"
"                </table>\n"
"                <table style=\"width:600px;margin:0px "
"auto;background:white;border:1px solid #e1e1e1;\">\n"
"                    <tbody>\n"
"                        <tr><td style=\"padding:15px 20px 10px 20px;\">\n"
"                            <p>Dear <t t-out=\"object.partner_id.name or "
"''\">Brandon Freeman</t>,</p>\n"
"                            <p>Your subscription <strong t-out=\"object.name "
"or ''\">Office Cleaning Service\"</strong> needs your attention.</p>\n"
"                            <p>We invite you to renew it by clicking on the "
"following link.</p>\n"
"                            <p>Kind regards.</p>\n"
"                        </td></tr>\n"
